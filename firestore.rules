rules_version = '2';

// Master Class. Deploy with: firebase deploy --only firestore:rules
// Signed-in users only, except public class listings, reviews, announcements,
// and the public demo/request roster. Cloud Functions use the Admin SDK and
// bypass these rules when they write fee reminders and announcement pushes.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function listingPath(listingId) {
      return /databases/$(database)/documents/listings/$(listingId);
    }

    function isMaster(listingId) {
      return signedIn()
        && get(listingPath(listingId)).data.creatorId == request.auth.uid;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function myMcId() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('mcId', '');
    }

    function validMcId(value) {
      return value is string && value.matches('^MC[0-9]{6,}$');
    }

    function hasMyEnrollment(listingId) {
      return hasProfile()
        && validMcId(myMcId())
        && exists(/databases/$(database)/documents/listings/$(listingId)/enrollments/$(myMcId()));
    }

    function hasInterest(listingId) {
      return signedIn()
        && exists(/databases/$(database)/documents/listings/$(listingId)/interests/$(request.auth.uid));
    }

    // The class screens load a roster with one collection read. A joined learner
    // (enrolment or interest) may read that class's roster. Outsiders may not.
    function canSeeRoster(listingId) {
      return isMaster(listingId) || hasMyEnrollment(listingId) || hasInterest(listingId);
    }

    function stringField(data, field, maxSize) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function profileShape() {
      let data = request.resource.data;
      return stringField(data, 'name', 120)
        && stringField(data, 'email', 200)
        && stringField(data, 'pictureUrl', 1000)
        && stringField(data, 'phoneNumber', 20)
        && stringField(data, 'city', 100)
        && stringField(data, 'preferredPhysicalCity', 100)
        && stringField(data, 'preferredEventCity', 100)
        && stringField(data, 'preferredPhysicalArea', 100)
        && stringField(data, 'expertDetails', 2000)
        && stringField(data, 'upiId', 100)
        && (!('role' in data) || data.role in ['Learner', 'Master'])
        && (!('topicInterests' in data) || (data.topicInterests is list && data.topicInterests.size() <= 40))
        && (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 20))
        && (!('registrationCompleted' in data) || data.registrationCompleted is bool)
        && (!('uid' in data) || data.uid == request.auth.uid)
        && (!('mcId' in data) || validMcId(data.mcId))
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('verified' in data) || data.verified is bool)
        && (!('followerCount' in data) || (data.followerCount is int && data.followerCount >= 0 && data.followerCount < 1000000));
    }

    // A valid MC ID, once stored, cannot be replaced.
    function mcIdUnchanged() {
      return !('mcId' in resource.data)
        || !(resource.data.mcId is string)
        || !resource.data.mcId.matches('^MC[0-9]{6,}$')
        || resource.data.mcId == request.resource.data.mcId;
    }

    function verifiedLocked() {
      return isAdmin()
        || (
          resource != null
          && request.resource.data.get('verified', false) == resource.data.get('verified', false)
        )
        || (
          resource == null
          && request.resource.data.get('verified', false) == false
        );
    }

    function followerCountStep(uid) {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
        && request.resource.data.followerCount is int
        && (
          (
            request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
            && exists(/databases/$(database)/documents/profiles/$(uid)/followers/$(request.auth.uid))
          )
          || (
            request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1
            && request.resource.data.followerCount >= 0
            && !exists(/databases/$(database)/documents/profiles/$(uid)/followers/$(request.auth.uid))
          )
        );
    }
    function noteShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(['title', 'body', 'kind', 'read', 'createdAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() <= 1000
        && data.kind in ['class_reminder', 'fee_due', 'announcement', 'listing_expiry', 'new_class', 'session_change', 'gallery']
        && data.read == false
        && data.createdAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isOwner(adminUid);
      allow list, create, update, delete: if false;
    }

    match /counters/{counterId} {
      allow get: if signedIn() && counterId == 'memberId';
      allow list: if false;
      allow create: if signedIn()
        && counterId == 'memberId'
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next == 100001;
      allow update: if signedIn()
        && counterId == 'memberId'
        && request.resource.data.keys().hasOnly(['next'])
        && resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && resource.data.next is int
        && request.resource.data.next == resource.data.next + 1
        && request.resource.data.next < 10000000;
      allow delete: if false;
    }

    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(uid) && profileShape() && verifiedLocked();
      allow update: if (
          isOwner(uid) && profileShape() && mcIdUnchanged() && verifiedLocked()
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified'])
        ) || followerCountStep(uid);
      allow delete: if false;

      match /notifications/{noteId} {
        allow read: if isOwner(uid);
        allow create: if noteShape() && (
          isOwner(uid)
          || (signedIn() && request.resource.data.kind == 'announcement')
          || (
            signedIn()
            && request.resource.data.kind == 'new_class'
            && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/followers/$(uid))
          )
          || (signedIn() && request.resource.data.kind == 'session_change')
          || (signedIn() && request.resource.data.kind == 'gallery')
        );
        allow update, delete: if isOwner(uid);
      }

      match /following/{masterId} {
        allow read: if isOwner(uid);
        allow create, delete: if isOwner(uid) && masterId.size() > 0 && masterId.size() <= 80;
        allow update: if false;
      }

      match /followers/{followerId} {
        allow read: if isOwner(uid) || isOwner(followerId);
        allow create, delete: if isOwner(followerId);
        allow update: if false;
      }

      match /blocks/{otherId} {
        allow read: if isOwner(uid) || isOwner(otherId);
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /verification/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500;
        allow update: if isAdmin()
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.ownerId == uid;
        allow delete: if false;
      }

      match /saved/{listingId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.listingId == listingId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.savedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /receivedReviews/{reviewId} {
        allow read: if isOwner(uid);
        allow create, update: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.masterId == uid
          && request.resource.data.listingId is string
          && reviewId == request.resource.data.listingId + '_' + request.auth.uid
          && request.resource.data.classRating is int
          && request.resource.data.classRating >= 1
          && request.resource.data.classRating <= 5
          && request.resource.data.masterRating is int
          && request.resource.data.masterRating >= 1
          && request.resource.data.masterRating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow delete: if isOwner(uid)
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    function nearNow(value) {
      return value is timestamp
        && value >= request.time - duration.value(10, 'm')
        && value <= request.time + duration.value(10, 'm');
    }

    function isOnlineListing(data) {
      return data.get('listing_type', '') == 'online'
        || data.get('type', '') == 'online_class';
    }

    // Online posts expire within 31 days of postedAt, or of renewedAt when renewed.
    function expiryWithinCap() {
      let data = request.resource.data;
      return !isOnlineListing(data)
        || !data.keys().hasAny(['expires_at'])
        || (
          data.expires_at is timestamp
          && (
            (
              data.keys().hasAny(['renewedAt'])
              && data.renewedAt is timestamp
              && nearNow(data.renewedAt)
              && data.expires_at > data.renewedAt
              && data.expires_at <= data.renewedAt + duration.value(31, 'd')
            )
            || (
              !data.keys().hasAny(['renewedAt'])
              && data.postedAt is timestamp
              && data.expires_at > data.postedAt
              && data.expires_at <= data.postedAt + duration.value(31, 'd')
              && (
                resource == null
                || !data.keys().hasAny(['postedAt'])
                || !('postedAt' in resource.data)
                || resource.data.postedAt == data.postedAt
                || nearNow(data.postedAt)
              )
            )
          )
        );
    }

    function isAcademyOwner(academyId) {
      return signedIn()
        && get(/databases/$(database)/documents/academies/$(academyId)).data.ownerId == request.auth.uid;
    }

    function acceptedTeacherInvite(academyId) {
      return (
          request.auth.token.email is string
          && exists(/databases/$(database)/documents/academyInvitesByEmail/$(request.auth.token.email)/items/$(academyId))
          && get(/databases/$(database)/documents/academyInvitesByEmail/$(request.auth.token.email)/items/$(academyId)).data.teacherUid == request.auth.uid
        )
        || (
          hasProfile()
          && validMcId(myMcId())
          && exists(/databases/$(database)/documents/academyInvitesByMc/$(myMcId())/items/$(academyId))
          && get(/databases/$(database)/documents/academyInvitesByMc/$(myMcId())/items/$(academyId)).data.teacherUid == request.auth.uid
        )
        || (
          hasProfile()
          && myPhone().size() >= 5
          && exists(/databases/$(database)/documents/academyInvitesByPhone/$(myPhone())/items/$(academyId))
          && get(/databases/$(database)/documents/academyInvitesByPhone/$(myPhone())/items/$(academyId)).data.teacherUid == request.auth.uid
        );
    }

    function isAcademyTeacher(academyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/academies/$(academyId)/teachers/$(request.auth.uid));
    }

    function attendancePlaceShape() {
      let data = request.resource.data;
      return data.markedByUid == request.auth.uid
        && data.mcId is string
        && data.mcId.size() <= 20
        && data.locationStatus in ['recorded', 'denied']
        && data.address is string
        && data.address.size() <= 300
        && data.away is bool
        && data.markedAt is timestamp
        && (!('accuracy' in data) || data.accuracy is number)
        && (!('distanceMeters' in data) || data.distanceMeters is int)
        && (
          data.locationStatus == 'denied'
          || (data.lat is number && data.lng is number)
        );
    }

    function myPhone() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('phoneNumber', '');
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && expiryWithinCap();
      allow update: if signedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && expiryWithinCap();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.creatorId == request.auth.uid);

      match /interests/{userId} {
        allow get: if isMaster(listingId) || isOwner(userId);
        allow list: if isMaster(listingId)
          || (signedIn() && resource.data.userId == request.auth.uid);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.listingId == listingId
          && request.resource.data.status == 'interested'
          && request.resource.data.listingTitle is string
          && request.resource.data.listingTitle.size() <= 200
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 120
          && stringField(request.resource.data, 'userEmail', 200)
          && stringField(request.resource.data, 'contactNumber', 20)
          && stringField(request.resource.data, 'createdAt', 40)
          && (
            !request.resource.data.keys().hasAny(['mcId'])
            || request.resource.data.mcId == null
            || request.resource.data.mcId == ''
            || validMcId(request.resource.data.mcId)
          );
        allow delete: if isOwner(userId);
      }

      match /enrollments/{mcId} {
        allow get: if isMaster(listingId)
          || (signedIn() && validMcId(myMcId()) && mcId == myMcId())
          || (resource != null && resource.data.userId == request.auth.uid);
        allow list: if canSeeRoster(listingId);
        allow create: if signedIn()
          && validMcId(mcId)
          && mcId == myMcId()
          && request.resource.data.mcId == mcId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 120
          && request.resource.data.attendees is list
          && request.resource.data.attendees.size() > 0
          && request.resource.data.attendees.size() <= 12;
        allow update: if request.resource.data.mcId == resource.data.mcId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.attendees is list
          && request.resource.data.attendees.size() <= 12
          && (
            isMaster(listingId)
            || (signedIn() && resource.data.userId == request.auth.uid && mcId == myMcId())
          );
        allow delete: if isMaster(listingId)
          || (signedIn() && resource.data.userId == request.auth.uid);
      }

      match /attendance/{sessionDate} {
        allow read: if canSeeRoster(listingId);
        allow create: if isMaster(listingId)
          && sessionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == sessionDate
          && request.resource.data.marks is map;
        allow update: if isMaster(listingId)
          && sessionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow delete: if false;
      }

      match /attendancePlaces/{sessionDate} {
        allow read: if isMaster(listingId);
        allow create: if isMaster(listingId)
          && sessionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.markedByUid == request.auth.uid
          && request.resource.data.date == sessionDate
          && attendancePlaceShape();
        allow update, delete: if false;
      }

      match /fees/{feeId} {
        allow read: if canSeeRoster(listingId);
        allow create: if isMaster(listingId)
          || (
            signedIn()
            && validMcId(myMcId())
            && request.resource.data.mcId == myMcId()
            && request.resource.data.attendeeId is string
            && request.resource.data.attendeeId.size() > 0
            && request.resource.data.attendeeId.size() <= 80
            && feeId == myMcId() + '_' + request.resource.data.attendeeId
            && request.resource.data.amountPaid == 0
            && request.resource.data.unitAmount is int
            && request.resource.data.unitAmount >= 0
            && request.resource.data.feePeriod in ['month', 'course']
          );
        allow update: if isMaster(listingId)
          || (
            signedIn()
            && resource.data.mcId == myMcId()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['utr', 'utrStatus', 'claimedAmount'])
            && request.resource.data.utr is string
            && request.resource.data.utr.size() > 0
            && request.resource.data.utr.size() <= 64
            && request.resource.data.utrStatus == 'submitted'
            && request.resource.data.claimedAmount is int
            && request.resource.data.claimedAmount >= 0
          );
        allow delete: if false;
      }

      match /reviews/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId)
          && request.resource.data.authorId == userId
          && request.resource.data.listingId == listingId
          && request.resource.data.classRating is int
          && request.resource.data.classRating >= 1
          && request.resource.data.classRating <= 5
          && request.resource.data.masterRating is int
          && request.resource.data.masterRating >= 1
          && request.resource.data.masterRating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (hasMyEnrollment(listingId) || hasInterest(listingId));
        allow delete: if isOwner(userId);
      }

      match /batches/{batchId} {
        allow read: if true;
        allow create, update: if isMaster(listingId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.days is list
          && request.resource.data.days.size() > 0
          && request.resource.data.days.size() <= 7
          && request.resource.data.time is string
          && request.resource.data.time.size() <= 8
          && request.resource.data.capacity is int
          && request.resource.data.capacity > 0
          && request.resource.data.capacity <= 500
          && request.resource.data.startDate is string
          && request.resource.data.endDate is string;
        allow delete: if isMaster(listingId);
      }

      match /announcements/{announcementId} {
        allow read: if true;
        allow create: if isMaster(listingId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.batchId is string
          && request.resource.data.createdAt is string;
        allow update, delete: if false;
      }

      function canJoinChat(listingId) {
        return isMaster(listingId) || hasInterest(listingId) || hasMyEnrollment(listingId) || isAdmin();
      }

      function notBlocked(otherId) {
        return !exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/blocks/$(otherId))
          && !exists(/databases/$(database)/documents/profiles/$(otherId)/blocks/$(request.auth.uid));
      }

      function isListingTeacher(listingId) {
        let data = get(listingPath(listingId)).data;
        return data.keys().hasAny(['academyId'])
          && data.academyId is string
          && isAcademyTeacher(data.academyId);
      }

      match /materials/{materialId} {
        allow read: if canJoinChat(listingId);
        allow create: if (isMaster(listingId) || isListingTeacher(listingId))
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.kind in ['pdf', 'image', 'note', 'link']
          && request.resource.data.authorId == request.auth.uid
          && (!('size' in request.resource.data) || (request.resource.data.size is int && request.resource.data.size <= 10 * 1024 * 1024));
        allow delete: if isMaster(listingId);
        allow update: if false;
      }

      match /coupons/{code} {
        allow read: if signedIn();
        allow create: if isMaster(listingId)
          && request.resource.data.kind in ['percent', 'flat']
          && request.resource.data.value is int
          && request.resource.data.value > 0
          && request.resource.data.value <= 100000
          && request.resource.data.used == 0
          && request.resource.data.limit is int
          && request.resource.data.limit >= 0
          && request.resource.data.limit <= 100000;
        allow delete: if isMaster(listingId);
        allow update: if isMaster(listingId)
          || (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
            && request.resource.data.used == resource.data.used + 1
            && get(/databases/$(database)/documents/listings/$(listingId)/couponUses/$(request.auth.uid)).data.userId == request.auth.uid
            && get(/databases/$(database)/documents/listings/$(listingId)/couponUses/$(request.auth.uid)).data.counted != true
            && getAfter(/databases/$(database)/documents/listings/$(listingId)/couponUses/$(request.auth.uid)).data.counted == true
          );
      }

      match /couponUses/{userId} {
        allow read: if isMaster(listingId) || isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 40
          && request.resource.data.counted == false;
        allow update: if isOwner(userId)
          && resource.data.counted != true
          && request.resource.data.counted == true
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.code == resource.data.code;
      }

      match /gallery/{postId} {
        allow get: if canJoinChat(listingId) && (
          resource.data.hidden == false
          || isMaster(listingId)
          || resource.data.authorId == request.auth.uid
        );
        allow list: if isMaster(listingId)
          || (canJoinChat(listingId) && resource.data.hidden == false);
        allow create: if (hasMyEnrollment(listingId) || hasInterest(listingId))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 300
          && request.resource.data.hidden == false;
        allow update: if (
          isMaster(listingId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        ) || (
          canJoinChat(listingId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.likes + 1
        );
        allow delete: if isMaster(listingId) || (signedIn() && resource.data.authorId == request.auth.uid);
      }

      match /gallery/{postId}/comments/{commentId} {
        allow read: if canJoinChat(listingId);
        allow create: if isMaster(listingId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /sessionRequests/{requestId} {
        allow read: if isMaster(listingId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create: if signedIn()
          && (hasInterest(listingId) || hasMyEnrollment(listingId))
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.kind in ['cancel', 'reschedule']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500;
        allow update: if isMaster(listingId)
          && request.resource.data.status in ['approved', 'declined']
          && request.resource.data.userId == resource.data.userId;
        allow delete: if false;
      }

      match /chats/{chatId} {
        allow read: if canJoinChat(listingId);
        allow create: if canJoinChat(listingId)
          && request.resource.data.listingId == listingId;
        allow update: if canJoinChat(listingId);
        allow delete: if isMaster(listingId);

        match /messages/{messageId} {
          allow read: if canJoinChat(listingId);
          allow create: if canJoinChat(listingId)
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && notBlocked(get(listingPath(listingId)).data.creatorId == request.auth.uid ? chatId : get(listingPath(listingId)).data.creatorId);
          allow update, delete: if false;
        }

        match /reads/{userId} {
          allow read, write: if isOwner(userId) && canJoinChat(listingId);
        }
      }
    }

    // Phone, email, and UPI stay off the public listing. A learner can read
    // them after they record their own interest, and an enrolled learner can
    // read them to pay. Everyone else cannot.
    match /listings_contact/{listingId} {
      allow get: if signedIn() && (
        resource.data.creatorId == request.auth.uid
        || hasInterest(listingId)
        || hasMyEnrollment(listingId)
        || isAdmin()
      );
      allow list: if false;
      allow create, update: if isMaster(listingId)
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.size() <= 20
        && stringField(request.resource.data, 'masterName', 120)
        && stringField(request.resource.data, 'masterEmail', 200)
        && stringField(request.resource.data, 'masterPhone', 20)
        && stringField(request.resource.data, 'upiId', 100)
        && stringField(request.resource.data, 'sessionLink', 500);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.creatorId == request.auth.uid);
    }

    match /registrations/{registrationId} {
      allow get: if signedIn() && (
        resource.data.userId == request.auth.uid
        || get(listingPath(resource.data.listingId)).data.creatorId == request.auth.uid
        || exists(/databases/$(database)/documents/community_responses/$(resource.data.listingId)/members/$(request.auth.uid))
      );
      allow list: if signedIn() && (
        resource.data.userId == request.auth.uid
        || get(listingPath(resource.data.listingId)).data.creatorId == request.auth.uid
      );
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.listingId is string
        && registrationId == 'response_' + request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.status in ['interested', 'master_ready', 'vote_0', 'creator']
        && (request.resource.data.status != 'creator' || isMaster(request.resource.data.listingId))
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 100
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 200;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /community_responses/{listingId}/members/{userId} {
      allow read: if true;

      function registrationAgrees() {
        let response = getAfter(
          /databases/$(database)/documents/registrations/$(request.resource.data.responseId)
        );
        return request.resource.data.responseId == 'response_' + listingId + '_' + userId
          && response.data.listingId == listingId
          && response.data.userId == userId
          && response.data.status == request.resource.data.status;
      }

      allow create, update: if signedIn()
        && (isOwner(userId) || isMaster(listingId))
        && request.resource.data.keys().hasOnly([
          'listingId', 'responseId', 'userId', 'userName', 'status'
        ])
        && request.resource.data.listingId == listingId
        && request.resource.data.userId == userId
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 100
        && request.resource.data.status in ['interested', 'master_ready', 'vote_0']
        && registrationAgrees();
      allow delete: if signedIn() && (isOwner(userId) || isMaster(listingId));
    }

    match /academies/{academyId} {
      allow get: if isAcademyOwner(academyId) || isAcademyTeacher(academyId);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow update, delete: if isAcademyOwner(academyId);

      match /teachers/{teacherUid} {
        allow read: if isAcademyOwner(academyId) || isOwner(teacherUid);
        allow create: if isAcademyOwner(academyId)
          || (
            isOwner(teacherUid)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'active'
            && acceptedTeacherInvite(academyId)
          );
        allow update: if isAcademyOwner(academyId)
          || (
            isOwner(teacherUid)
            && request.resource.data.salaryAmount == resource.data.salaryAmount
          );
        allow delete: if isAcademyOwner(academyId);
      }

      match /batches/{batchId} {
        allow read: if isAcademyOwner(academyId)
          || resource.data.teacherUid == request.auth.uid;
        allow create, update, delete: if isAcademyOwner(academyId);
      }

      match /students/{studentId} {
        allow get: if isAcademyOwner(academyId)
          || isAcademyTeacher(academyId)
          || (signedIn() && validMcId(myMcId()) && studentId == myMcId())
          || (signedIn() && resource.data.userId == request.auth.uid);
        allow list: if isAcademyOwner(academyId)
          || (isAcademyTeacher(academyId) && resource.data.batchTeacherUid == request.auth.uid);
        allow create, update, delete: if isAcademyOwner(academyId);
      }

      match /salaries/{salaryId} {
        allow read: if isAcademyOwner(academyId)
          || resource.data.teacherUid == request.auth.uid;
        allow create, update: if isAcademyOwner(academyId);
        allow delete: if false;
      }

      match /attendance/{recordId} {
        allow read: if isAcademyOwner(academyId) || resource.data.teacherUid == request.auth.uid;
        allow create, update: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.batchId is string
          && get(/databases/$(database)/documents/academies/$(academyId)/batches/$(request.resource.data.batchId)).data.teacherUid == request.auth.uid;
        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow read: if isAcademyOwner(academyId) || isAcademyTeacher(academyId);
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.batchId is string
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && get(/databases/$(database)/documents/academies/$(academyId)/batches/$(request.resource.data.batchId)).data.teacherUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /attendancePlaces/{recordId} {
        allow get: if isAcademyOwner(academyId)
          || (signedIn() && resource.data.markedByUid == request.auth.uid);
        allow list: if isAcademyOwner(academyId);
        allow create: if signedIn()
          && request.resource.data.markedByUid == request.auth.uid
          && request.resource.data.batchId is string
          && request.resource.data.date is string
          && (
            isAcademyOwner(academyId)
            || get(/databases/$(database)/documents/academies/$(academyId)/batches/$(request.resource.data.batchId)).data.teacherUid == request.auth.uid
          )
          && attendancePlaceShape();
        allow update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read, create, update, delete: if isAcademyOwner(academyId);
      }
    }

    function invitePayloadOk(academyId) {
      return request.resource.data.ownerId == request.auth.uid
        && request.resource.data.academyId == academyId
        && request.resource.data.status == 'invited'
        && request.resource.data.academyName is string;
    }

    match /academyInvitesByEmail/{email}/items/{academyId} {
      allow read: if signedIn() && email == request.auth.token.email;
      allow create: if signedIn() && invitePayloadOk(academyId);
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (
          email == request.auth.token.email
          && request.resource.data.status == 'accepted'
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /academyInvitesByMc/{mcId}/items/{academyId} {
      allow read: if signedIn() && validMcId(myMcId()) && mcId == myMcId();
      allow create: if signedIn() && invitePayloadOk(academyId);
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (
          validMcId(myMcId())
          && mcId == myMcId()
          && request.resource.data.status == 'accepted'
          && request.resource.data.teacherUid == request.auth.uid
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /academyInvitesByPhone/{phone}/items/{academyId} {
      allow read: if signedIn() && myPhone() == phone && phone.size() >= 5;
      allow create: if signedIn() && invitePayloadOk(academyId);
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (
          myPhone() == phone
          && request.resource.data.status == 'accepted'
          && request.resource.data.teacherUid == request.auth.uid
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 120;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
